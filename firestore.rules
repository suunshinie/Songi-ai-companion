rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Require email verification for email/password & federated accounts while explicitly supporting anonymous private sessions
    function isAllowedAccount() {
      return isSignedIn() && (
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        request.auth.token.email_verified == true
      );
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'authMethod',
          'emailVerified',
          'preferredLanguage',
          'proactiveCheckins',
          'ephemeralMode',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'authMethod',
          'emailVerified',
          'preferredLanguage',
          'proactiveCheckins',
          'ephemeralMode',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.authMethod in ['anonymous', 'google', 'email']
        && data.emailVerified is bool
        && data.preferredLanguage in ['en', 'bn']
        && data.proactiveCheckins is bool
        && data.ephemeralMode is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemory(data, memoryId, userId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'text',
          'meta',
          'isNew',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'text',
          'meta',
          'isNew',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == memoryId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 300
        && data.meta is string
        && data.meta.size() >= 1
        && data.meta.size() <= 120
        && data.isNew is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJournalEntry(data, entryId, userId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'dateLabel',
          'relativeTimeLabel',
          'title',
          'body',
          'mood',
          'tags',
          'aiLocked',
          'updatedAtLabel',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'dateLabel',
          'banglaDateLabel',
          'relativeTimeLabel',
          'title',
          'body',
          'mood',
          'tags',
          'aiLocked',
          'updatedAtLabel',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == entryId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.dateLabel is string
        && data.dateLabel.size() >= 1
        && data.dateLabel.size() <= 60
        && (!('banglaDateLabel' in data) || (data.banglaDateLabel is string && data.banglaDateLabel.size() <= 60))
        && data.relativeTimeLabel is string
        && data.relativeTimeLabel.size() >= 1
        && data.relativeTimeLabel.size() <= 60
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 180
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 8000
        && data.mood in ['Calm', 'Heavy', 'Hopeful', 'Restless']
        && data.tags is list
        && data.tags.size() <= 8
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        && data.aiLocked is bool
        && data.updatedAtLabel is string
        && data.updatedAtLabel.size() >= 1
        && data.updatedAtLabel.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Boot connectivity check doc (non-PII, single document read only)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, write: if false;
    }

    // User Sanctuary Profile (strictly owner-isolated, no list)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isAllowedAccount()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isAllowedAccount()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update display preferences & consent toggles
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'authMethod',
            'emailVerified',
            'preferredLanguage',
            'proactiveCheckins',
            'ephemeralMode',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(userId) && isOwner(userId);

      // Approved Companion Memories Subcollection (Master Gate -> parent /users/{userId})
      match /memories/{memoryId} {
        allow get: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && isAllowedAccount();

        allow list: if isOwner(userId)
          && isAllowedAccount()
          && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && isAllowedAccount()
          && isValidMemory(incoming(), memoryId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && isAllowedAccount()
          && isValidMemory(incoming(), memoryId, userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action: Edit approved memory text or acknowledge new badge
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'meta', 'isNew', 'updatedAt'])
          );

        allow delete: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && isAllowedAccount();
      }

      // Encrypted Personal Journal Subcollection (Master Gate -> parent /users/{userId})
      match /journal/{entryId} {
        allow get: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isAllowedAccount();

        allow list: if isOwner(userId)
          && isAllowedAccount()
          && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isAllowedAccount()
          && isValidJournalEntry(incoming(), entryId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isAllowedAccount()
          && isValidJournalEntry(incoming(), entryId, userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action: Edit journal entry content, mood, tags, or AI lock state
            incoming().diff(existing()).affectedKeys().hasOnly([
              'dateLabel',
              'banglaDateLabel',
              'relativeTimeLabel',
              'title',
              'body',
              'mood',
              'tags',
              'aiLocked',
              'updatedAtLabel',
              'updatedAt'
            ])
          );

        allow delete: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isAllowedAccount();
      }
    }
  }
}
