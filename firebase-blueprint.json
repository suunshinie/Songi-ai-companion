{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User sanctuary profile and privacy settings isolated per authenticated user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID owning this profile",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User-chosen display name or Anonymous Sanctuary Guest",
          "minLength": 1,
          "maxLength": 80
        },
        "authMethod": {
          "type": "string",
          "enum": ["anonymous", "google", "email"],
          "description": "Authentication provider used to sign in"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the account email is verified"
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "bn"],
          "description": "UI language preference"
        },
        "proactiveCheckins": {
          "type": "boolean",
          "description": "Consent toggle for optional gentle evening check-in reminders"
        },
        "ephemeralMode": {
          "type": "boolean",
          "description": "Toggle for local-first ephemeral chat drafts"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp"
        }
      },
      "required": [
        "uid",
        "displayName",
        "authMethod",
        "emailVerified",
        "preferredLanguage",
        "proactiveCheckins",
        "ephemeralMode",
        "createdAt",
        "updatedAt"
      ]
    },
    "ApprovedMemory": {
      "title": "ApprovedMemory",
      "description": "User-ratified context memory explicitly approved for AI Companion personalization.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "meta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "isNew": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "text",
        "meta",
        "isNew",
        "createdAt",
        "updatedAt"
      ]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Private user journal entry with AI-Lock flag.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "banglaDateLabel": {
          "type": "string",
          "maxLength": 60
        },
        "relativeTimeLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "mood": {
          "type": "string",
          "enum": ["Calm", "Heavy", "Hopeful", "Restless"]
        },
        "tags": {
          "type": "array",
          "description": "Up to 8 short topical tags"
        },
        "aiLocked": {
          "type": "boolean"
        },
        "updatedAtLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "dateLabel",
        "relativeTimeLabel",
        "title",
        "body",
        "mood",
        "tags",
        "aiLocked",
        "updatedAtLabel",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private sanctuary profile and consent preferences owned strictly by userId."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/ApprovedMemory" },
      "description": "Approved AI Companion memories scoped under the owning user profile."
    },
    "/users/{userId}/journal/{entryId}": {
      "schema": { "$ref": "#/entities/JournalEntry" },
      "description": "Private personal journal entries scoped under the owning user profile."
    }
  }
}
